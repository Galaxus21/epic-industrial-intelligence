# EPIC — Environment Configuration
# Copy this file to .env and fill in your values

# ─────────────────────────────────────────────
# LLM Configuration (optional — without a model, answers say AI is unavailable)
# ─────────────────────────────────────────────
# OpenAI: paste a key from https://platform.openai.com/api-keys, or leave empty to use Ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Ollama (https://ollama.com/download): run `ollama pull qwen2.5:7b`, `ollama pull nomic-embed-text` and
# `ollama create epic-qwen2.5 -f backend/ollama/epicChat.Modelfile` first (the Modelfile raises the context window).
# Compose points the backend at http://host.docker.internal:11434; set this only for a non-Docker run.
# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=epic-qwen2.5
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ─────────────────────────────────────────────
# Security (REQUIRED — change for production)
# ─────────────────────────────────────────────
# Used to sign auth tokens. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-real-secret

# ─────────────────────────────────────────────
# Database Password (REQUIRED — set a strong password)
# ─────────────────────────────────────────────
# Do not use default or predictable passwords in development or production.
# Generate strong secrets (e.g. with: openssl rand -base64 24 or python -c "import secrets; print(secrets.token_urlsafe(24))")
POSTGRES_PASSWORD=<generate_strong_postgres_password>

# ─────────────────────────────────────────────
# App Settings
# ─────────────────────────────────────────────
ENVIRONMENT=development

# Set to true to allow auto-registration of entities from document ingestion
AUTO_REGISTER_ENTITIES=false
