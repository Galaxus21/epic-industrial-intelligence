# AI Operations Brain — Environment Configuration
# Copy this file to .env and fill in your values

# ─────────────────────────────────────────────
# LLM Configuration (REQUIRED for live AI responses)
# ─────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# GPT model to use (gpt-4.1 recommended for hackathon)
OPENAI_MODEL=gpt-4.1

# ─────────────────────────────────────────────
# Database Passwords (change for production)
# ─────────────────────────────────────────────
NEO4J_PASSWORD=opsbrain2024
POSTGRES_PASSWORD=opsbrain2024

# ─────────────────────────────────────────────
# Optional: Azure Document Intelligence (OCR)
# Leave blank to use fallback OCR (PyMuPDF)
# ─────────────────────────────────────────────
AZURE_DOC_INTEL_ENDPOINT=
AZURE_DOC_INTEL_KEY=

# ─────────────────────────────────────────────
# App Settings
# ─────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=info
