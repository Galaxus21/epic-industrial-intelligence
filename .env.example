# EPIC — Environment Configuration
# Copy this file to .env and fill in your values

# ─────────────────────────────────────────────
# LLM Configuration (REQUIRED for live AI responses)
# ─────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# GPT model to use (gpt-4.1 recommended)
OPENAI_MODEL=gpt-4.1

# ─────────────────────────────────────────────
# Security (REQUIRED — change for production)
# ─────────────────────────────────────────────
# Used to sign auth tokens. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-real-secret

# ─────────────────────────────────────────────
# Database Password (REQUIRED — set a strong password)
# ─────────────────────────────────────────────
# Do not use default or predictable passwords in development or production.
# Generate strong secrets (e.g. with: openssl rand -base64 24 or python -c "import secrets; print(secrets.token_urlsafe(24))")
POSTGRES_PASSWORD=<generate_strong_postgres_password>

# ─────────────────────────────────────────────
# App Settings
# ─────────────────────────────────────────────
ENVIRONMENT=development

# Set to true to allow auto-registration of entities from document ingestion
AUTO_REGISTER_ENTITIES=false
